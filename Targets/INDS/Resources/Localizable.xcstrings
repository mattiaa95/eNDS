    "Pair a game controller in iOS Settings → Bluetooth, then come back here to customize its buttons.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln Sie einen Gamecontroller in den iOS-Einstellungen → Bluetooth und kehren Sie anschließend hierher zurück, um die Tasten anzupassen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja un mando de videojuegos en Ajustes de iOS → Bluetooth y, a continuación, vuelve aquí para personalizar sus botones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associez une manette de jeu dans les Réglages iOS → Bluetooth, puis revenez ici pour personnaliser ses boutons."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Associa un controller di gioco nelle Impostazioni di iOS → Bluetooth, poi torna qui per personalizzarne i pulsanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの「設定」→「Bluetooth」でゲームコントローラーをペアリングしてから、ここに戻ってボタンの設定をカスタマイズしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 설정 → 블루투스에서 게임 컨트롤러를 페어링한 다음, 다시 이곳으로 돌아와 버튼을 사용자 지정하세요."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparelhe um comando de jogos em «Definições» → «Bluetooth» no iOS e, em seguida, volte aqui para personalizar os seus botões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите игровой контроллер в «Настройках» iOS → «Bluetooth», а затем вернитесь сюда, чтобы настроить его кнопки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iOS“设置”→“蓝牙”中配对游戏手柄，然后返回此处自定义其按键。"
          }
        }
      }
    },

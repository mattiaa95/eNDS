    "Reposition, resize, hide, and restyle every button, per orientation.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Schaltfläche kann je nach Ausrichtung neu positioniert, in der Größe angepasst, ausgeblendet und neu gestaltet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia la posición, el tamaño, oculta y modifica el estilo de cada botón, según la orientación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositionnez, redimensionnez, masquez et modifiez l'apparence de chaque bouton, en fonction de l'orientation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È possibile riposizionare, ridimensionare, nascondere e modificare lo stile di ogni pulsante, a seconda dell'orientamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面の向きごとに、各ボタンの位置変更、サイズ変更、非表示、およびスタイル変更を行う。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "화면 방향에 따라 각 버튼의 위치 조정, 크기 조정, 숨기기 및 스타일 변경을 수행합니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reposicionar, redimensionar, ocultar e alterar o estilo de cada botão, consoante a orientação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменяйте положение, размер, скрывайте и настраивайте стиль каждой кнопки в зависимости от ориентации экрана."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据屏幕方向，对每个按钮进行重新定位、调整大小、隐藏和重新设计样式。"
          }
        }
      }
    },

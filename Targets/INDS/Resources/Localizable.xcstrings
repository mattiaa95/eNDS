    "Slot 1 + auto-save are free — PRO unlocks slots 2-4": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Slot 1 + automatische Speicherung sind kostenlos – Mit der PRO-Version werden die Slots 2–4 freigeschaltet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ranura 1 y el guardado automático son gratuitos; la versión PRO desbloquea las ranuras 2 a 4"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'emplacement 1 et la sauvegarde automatique sont gratuits — La version PRO débloque les emplacements 2 à 4"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo slot 1 e il salvataggio automatico sono gratuiti — La versione PRO sblocca gli slot 2-4"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スロット1と自動保存機能は無料で利用可能 — PROプランではスロット2～4が利用可能になります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬롯 1과 자동 저장 기능은 무료입니다 — PRO 버전을 이용하면 슬롯 2~4를 사용할 수 있습니다"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Slot 1 + o salvamento automático são gratuitos — a versão PRO desbloqueia os slots 2 a 4"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слот 1 и функция автосохранения доступны бесплатно — версия PRO открывает слоты 2–4"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "插槽 1 + 自动保存功能免费 — PRO 版可解锁插槽 2-4"
          }
        }
      }
    },
    "Slots 2-4 are a PRO feature — slot 1 and auto-save are always free.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Plätze 2–4 sind eine PRO-Funktion — Platz 1 und die automatische Speicherung sind immer kostenlos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los espacios 2–4 son una función PRO — el espacio 1 y el autoguardado son siempre gratis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les emplacements 2–4 sont une fonction PRO — l'emplacement 1 et la sauvegarde auto restent gratuits."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli slot 2–4 sono una funzione PRO — lo slot 1 e il salvataggio automatico sono sempre gratuiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スロット2〜4は PRO 機能です。スロット1と自動セーブは常に無料です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬롯 2–4는 PRO 기능입니다. 슬롯 1과 자동 저장은 항상 무료입니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As posições 2–4 são uma função PRO — a posição 1 e o guardar automático são sempre gratuitos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слоты 2–4 — функция PRO; слот 1 и автосохранение всегда бесплатны."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档位 2–4 为 PRO 功能——存档位 1 与自动存档始终免费。"
          }
        }
      }
    },

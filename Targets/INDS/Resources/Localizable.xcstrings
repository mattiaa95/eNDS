    "We miss you! Your subscription expired.\nCome back and unlock everything again.": {
      "comment": "Win-back message",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir vermissen dich! Dein Abonnement ist abgelaufen.\nKomm zurück und schalte alle Inhalte wieder frei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Te echamos de menos! Tu suscripción ha caducado.\nVuelve y vuelve a desbloquear todo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nous manques ! Ton abonnement a expiré.\nReviens pour débloquer à nouveau toutes les fonctionnalités."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci manchi! Il tuo abbonamento è scaduto.\nTorna a trovarci e sblocca di nuovo tutti i contenuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会いたいです！ご契約期間が終了しました。\nぜひ戻ってきて、すべてのコンテンツを再び利用できるようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그립네요! 구독 기간이 만료되었습니다.\n다시 방문하셔서 모든 콘텐츠를 다시 이용하세요."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Temos saudades tuas! A tua subscrição expirou.\nVolta e desbloqueia tudo novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы скучаем по тебе! Срок твоей подписки истек.\nВернись и снова получи доступ ко всему контенту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们想念你！你的订阅已过期。\n快回来，再次解锁所有内容吧。"
          }
        }
      }
    },

    "Unknown BIOS/firmware file \"%1$@\". Expected bios7.bin, bios9.bin, or firmware.bin.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbekannte BIOS-/Firmware-Datei „%1$@“. Erwartet werden bios7.bin, bios9.bin oder firmware.bin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo de BIOS o firmware desconocido: «%1$@». Se esperaba bios7.bin, bios9.bin o firmware.bin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier BIOS/firmware inconnu : « %1$@ ». Les noms attendus sont bios7.bin, bios9.bin ou firmware.bin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File BIOS/firmware sconosciuto “%1$@”. Nomi ammessi: bios7.bin, bios9.bin o firmware.bin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明なBIOS/ファームウェアファイル「%1$@」です。bios7.bin、bios9.bin、firmware.bin のいずれかを指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알 수 없는 BIOS/펌웨어 파일 “%1$@”입니다. bios7.bin, bios9.bin 또는 firmware.bin이어야 합니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ficheiro de BIOS/firmware desconhecido: «%1$@». Esperava-se bios7.bin, bios9.bin ou firmware.bin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неизвестный файл BIOS/прошивки «%1$@». Ожидались bios7.bin, bios9.bin или firmware.bin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未知的 BIOS/固件文件“%1$@”。应为 bios7.bin、bios9.bin 或 firmware.bin。"
          }
        }
      }
    },

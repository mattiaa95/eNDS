    "Built with care by an independent developer.\nYour support keeps eNDS moving forward.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Sorgfalt von einem unabhängigen Entwickler gebaut.\nDeine Unterstützung bringt eNDS voran."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creada con esmero por un desarrollador independiente.\nTu apoyo hace que eNDS siga avanzando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conçu avec soin par un développeur indépendant.\nVotre soutien fait avancer eNDS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creato con cura da uno sviluppatore indipendente.\nIl tuo supporto fa crescere eNDS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人開発者が丹精込めて作っています。\nあなたのサポートが eNDS を前へ進めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독립 개발자가 정성껏 만들었습니다.\n여러분의 지원이 eNDS를 발전시킵니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Criada com cuidado por um programador independente.\nO seu apoio faz o eNDS avançar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделано с заботой независимым разработчиком.\nВаша поддержка помогает eNDS развиваться."
          }
        },
        "zh-Hans": {

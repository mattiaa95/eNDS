    },
    "Battery Saver is holding speed at 1x — see Settings > Battery": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Energiesparmodus hält das Tempo bei 1x – siehe Einstellungen > Akku"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ahorro de batería mantiene la velocidad en 1x — mira Ajustes > Batería"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'économiseur de batterie maintient la vitesse à 1x — voir Réglages > Batterie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risparmio energetico tiene la velocità a 1x — vedi Impostazioni > Batteria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "低電力モードにより速度は1xに制限されています（設定＞バッテリー）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저전력 모드로 속도가 1x로 제한됩니다 — 설정 > 배터리 참고"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A poupança de bateria está a manter a velocidade em 1x — ver Definições > Bateria"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим энергосбережения удерживает скорость на 1x — см. Настройки > Батарея"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低电量模式将速度限制为 1x — 见设置 > 电池"
          }
        }
      }
    },
    "Billed %@ per %@. Renews automatically unless cancelled at least 24 hours before the end of the current period. Manage or cancel in your App Store account settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrechnung: %@ pro %@. Verlängert sich automatisch, sofern nicht mindestens 24 Stunden vor Ende des laufenden Zeitraums gekündigt wird. Verwalten oder kündigen kannst du in den Einstellungen deines App-Store-Accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te cobrará %@ por %@. Se renueva automáticamente salvo que la canceles al menos 24 horas antes de que termine el periodo en curso. Puedes gestionarla o cancelarla en los ajustes de tu cuenta de App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facturé %@ par %@. Se renouvelle automatiquement sauf résiliation au moins 24 heures avant la fin de la période en cours. Vous pouvez gérer ou résilier dans les réglages de votre compte App Store."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti verrà addebitato %@ ogni %@. Si rinnova automaticamente se non la disdici almeno 24 ore prima della fine del periodo in corso. Puoi gestirla o disdirla nelle impostazioni del tuo account App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ごとに%1$@が請求されます。現在の期間が終了する24時間前までに解約しない限り、自動的に更新されます。App Storeのアカウント設定で管理・解約できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@마다 %1$@이(가) 청구됩니다. 현재 기간 종료 24시간 전까지 해지하지 않으면 자동으로 갱신됩니다. App Store 계정 설정에서 관리하거나 해지할 수 있습니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cobrança de %@ por %@. Renova-se automaticamente exceto se cancelar até 24 horas antes do fim do período em curso. Pode gerir ou cancelar nas definições da sua conta App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Списание %@ за %@. Продлевается автоматически, если не отменить не менее чем за 24 часа до окончания текущего периода. Управлять подпиской или отменить её можно в настройках аккаунта App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每%2$@收取%1$@。除非在当前周期结束前至少24小时取消，否则将自动续订。您可以在 App Store 账户设置中管理或取消。"
          }
        }
      }
    },
    "Blow into the mic — games that listen actually hear you.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Puste ins Mikrofon – Spiele, die zuhören, hören dich wirklich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopla al micrófono: los juegos que escuchan te oyen de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soufflez dans le micro — les jeux qui écoutent vous entendent vraiment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Soffia nel microfono: i giochi che ascoltano ti sentono davvero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクに息を吹きかけよう。音を聞くゲームが本当に反応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크에 숨을 불어보세요. 소리를 듣는 게임이 정말로 반응합니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopre para o microfone — os jogos que ouvem, ouvem-no mesmo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подуйте в микрофон — игры, которые слушают, действительно вас слышат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对着麦克风吹气——会聆听的游戏真的能听到你。"
          }
        }
      }
    },

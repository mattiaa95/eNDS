    "No ROM named \"%1$@.nds\" was found. Import the ROM before its save file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein ROM mit dem Namen „%1$@.nds“ gefunden. Importiere erst das ROM, dann die Speicherdatei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ninguna ROM con el nombre «%1$@.nds». Importa la ROM antes que su archivo de guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune ROM nommée « %1$@.nds » n'a été trouvée. Importez la ROM avant son fichier de sauvegarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna ROM chiamata “%1$@.nds” trovata. Importa la ROM prima del suo file di salvataggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@.nds」という名前のROMが見つかりません。セーブデータより先にROMを読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@.nds”라는 ROM을 찾을 수 없습니다. 저장 파일보다 ROM을 먼저 가져오세요."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",

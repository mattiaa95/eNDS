    "Each line must be two 8-digit hex values separated by a space, e.g. 94000130 FFFB0000.": {
      "comment": "Cheat code validation error",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zeile muss aus zwei 8-stelligen Hexadezimalwerten bestehen, die durch ein Leerzeichen getrennt sind, z. B. 94000130 FFFB0000."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada línea debe contener dos valores hexadecimales de 8 dígitos separados por un espacio; por ejemplo: 94000130 FFFB0000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne doit comporter deux valeurs hexadécimales de 8 chiffres séparées par un espace, par exemple : 94000130 FFFB0000."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni riga deve contenere due valori esadecimali di 8 cifre separati da uno spazio, ad esempio 94000130 FFFB0000."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各行は、スペースで区切られた2つの8桁の16進数値でなければなりません。例：94000130 FFFB0000。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 줄은 공백으로 구분된 두 개의 8자리 16진수 값으로 구성되어야 합니다. 예: 94000130 FFFB0000."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada linha deve conter dois valores hexadecimais de 8 dígitos, separados por um espaço, por exemplo: 94000130 FFFB0000."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая строка должна состоять из двух 8-значных шестнадцатеричных значений, разделенных пробелом, например: 94000130 FFFB0000."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行必须包含两个由空格分隔的8位十六进制值，例如 94000130 FFFB0000。"
          }
        }
      }
    },

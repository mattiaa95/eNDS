    "Connect any MFi or Bluetooth gamepad — buttons map automatically to a real DS layout.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde ein beliebiges MFi- oder Bluetooth-Gamepad – die Tasten landen automatisch auf einem echten DS-Layout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta cualquier mando MFi o Bluetooth: los botones se asignan solos a una disposición de DS real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez n'importe quelle manette MFi ou Bluetooth — les boutons se configurent automatiquement selon la disposition d'une vraie DS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega un gamepad MFi o Bluetooth qualsiasi — i pulsanti si mappano da soli sul layout originale del DS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MFiやBluetoothのゲームパッドを接続するだけ。ボタンは本物のDSの配置に自動で割り当てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MFi 또는 Bluetooth 게임패드를 연결하세요 — 버튼이 실제 DS 배치에 맞춰 자동으로 매핑됩니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue qualquer comando MFi ou Bluetooth — os botões são mapeados automaticamente para a disposição de uma DS real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите любой геймпад MFi или Bluetooth — кнопки автоматически встанут так же, как на настоящей DS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接任意 MFi 或 Bluetooth 手柄——按键会自动映射为真实的 DS 布局。"
          }
        }
      }

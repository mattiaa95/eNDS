        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экранный контроллер и вибрация"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕手柄与触感反馈"
          }
        }
      }
    },
    "One code line per pair: address then value, e.g. 94000130 FFFB0000.": {
      "comment": "Cheat code format hint",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je Paar eine Codezeile: zuerst die Adresse, dann der Wert, z. B. 94000130 FFFB0000."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea de código por par: primero la dirección y luego el valor, p. ej., 94000130 FFFB0000."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne de code par paire : l'adresse suivie de la valeur, par exemple 94000130 FFFB0000."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una riga di codice per ogni coppia: prima l'indirizzo, poi il valore, ad esempio 94000130 FFFB0000."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行につき1組のコードを記述してください。まずアドレス、その次に値を記載します。例：94000130 FFFB0000。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 쌍당 한 줄씩 입력하세요: 주소 다음에 값 순서대로, 예: 94000130 FFFB0000."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha de código por par: primeiro o endereço e depois o valor, por exemplo, 94000130 FFFB0000."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одной строке кода на каждую пару: сначала адрес, затем значение, например: 94000130 FFFB0000."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每对数据占一行代码：先是地址，然后是值，例如 94000130 FFFB0000。"
          }
        }
      }
    },
    "One-time payment of %@ — yours forever.": {
      "comment": "Lifetime pricing breakdown",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmalzahlung von %@ – und es gehört für immer Ihnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago único de %@: tuyo para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un paiement unique de %@ — et c'est à vous pour toujours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagamento una tantum di %@ — tuo per sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の1回払い — 永久にあなたのものになります。"
          }

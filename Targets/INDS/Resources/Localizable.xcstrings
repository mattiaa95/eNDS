    "Unsupported file type .%1$@. Import a .nds ROM, a .zip/.7z/.gz archive, or a .sav save file.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht unterstützter Dateityp .%1$@. Importiere ein .nds-ROM, ein .zip-/.7z-/.gz-Archiv oder eine .sav-Speicherdatei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo de archivo no compatible: .%1$@. Importa una ROM .nds, un archivo .zip/.7z/.gz o una partida guardada .sav."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Type de fichier non pris en charge : .%1$@. Importez une ROM .nds, une archive .zip/.7z/.gz ou un fichier de sauvegarde .sav."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo di file .%1$@ non supportato. Importa una ROM .nds, un archivio .zip/.7z/.gz o un file di salvataggio .sav."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ".%1$@ は対応していないファイル形式です。.nds のROM、.zip/.7z/.gz のアーカイブ、または .sav のセーブデータを読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원하지 않는 파일 형식 .%1$@입니다. .nds ROM, .zip/.7z/.gz 아카이브 또는 .sav 저장 파일을 가져오세요."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo de ficheiro não suportado: .%1$@. Importe uma ROM .nds, um arquivo .zip/.7z/.gz ou um ficheiro de gravação .sav."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподдерживаемый тип файла .%1$@. Импортируйте ROM .nds, архив .zip/.7z/.gz или файл сохранения .sav."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持的文件类型 .%1$@。请导入 .nds ROM、.zip/.7z/.gz 压缩包或 .sav 存档文件。"
          }
        }
      }
    },

    "Vibrate on button presses and pause menu actions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei Tastendruck und bei Menüaktionen vibrieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrar al pulsar los botones y al realizar acciones en el menú de pausa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrer lorsque l'on appuie sur un bouton et lors des actions du menu de pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrare quando si premono i pulsanti e durante le azioni del menu di pausa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボタンを押したときやメニュー操作を一時停止したときに振動する。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버튼을 누르거나 메뉴에서 일시 정지 작업을 수행할 때 진동이 발생합니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Vibrar ao premir os botões e ao realizar ações no menu de pausa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включить вибрацию при нажатии кнопок и при выполнении действий в меню паузы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

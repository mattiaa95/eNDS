    "Free trial — then %@ / %@, auto-renewing. Cancel anytime.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenlos testen — danach %@ / %@, verlängert sich automatisch. Jederzeit kündbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Free trial — then %1$@ / %2$@, auto-renewing. Cancel anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba gratis — después %@ / %@, con renovación automática. Cancela cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essai gratuit — ensuite %@ / %@, renouvellement automatique. Annulable à tout moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova gratuita — poi %@ / %@, con rinnovo automatico. Disdici quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料トライアル後は %@／%@、自動更新。いつでもキャンセル可能。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무료 체험 후 %@ / %@, 자동 갱신. 언제든지 취소 가능."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Teste grátis — depois %@ / %@, com renovação automática. Cancele quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатный период — затем %@ / %@, автопродление. Отмена в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费试用后 %@／%@，自动续订。可随时取消。"
          }
        }
      }
    },

    "Remap a physical controller's buttons, including hotkeys for Quick Save, Quick Load, Cycle Screen Layout and Swap Screens.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tasten eines physischen Controllers neu belegen, einschließlich der Hotkeys für „Schnellspeichern“, „Schnellladen“, „Bildschirmlayout wechseln“ und „Bildschirme tauschen“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasigna los botones de un mando físico, incluidas las teclas de acceso rápido para «Guardar rápido», «Cargar rápido», «Cambiar la disposición de la pantalla» y «Intercambiar pantallas»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconfigurez les boutons d'une manette physique, y compris les raccourcis clavier pour la sauvegarde rapide, la charge rapide, le changement de disposition d'écran et l'alternance entre les écrans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimappa i pulsanti di un controller fisico, inclusi i tasti di scelta rapida per “Salvataggio rapido”, “Caricamento rapido”, “Cambio layout schermata” e “Scambio schermate”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "物理コントローラーのボタンを再割り当てします。これには、「クイックセーブ」、「クイックロード」、「画面レイアウトの切り替え」、「画面の入れ替え」のホットキーも含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물리적 컨트롤러의 버튼을 재매핑할 수 있으며, 여기에는 빠른 저장, 빠른 불러오기, 화면 레이아웃 순환 및 화면 전환을 위한 단축키도 포함됩니다."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reatribuir as teclas de um comando físico, incluindo teclas de atalho para «Gravação Rápida», «Carregamento Rápido», «Alternar o Layout do Ecrã» e «Trocar de Ecrã»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переназначить кнопки физического контроллера, включая горячие клавиши для быстрой записи, быстрой загрузки, переключения схемы расположения экранов и смены экранов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新映射物理控制器的按键，包括“快速保存”、“快速加载”、“循环屏幕布局”和“切换屏幕”的快捷键。"
          }
        }
      }
    },
